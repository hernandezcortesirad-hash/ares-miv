# Copia este archivo como .env.local y rellena tus valores (.env.local está en .gitignore).

# Token gratuito de https://ion.cesium.com/tokens
# Sin token, el visor funciona igual pero sin relieve 3D (solo imagen MOLA/Viking sobre el elipsoide).
VITE_CESIUM_ION_TOKEN=

# Asset de Cesium ion con el terreno 3D de Marte ("Cesium Mars").
# Si cambia, búscalo en el Asset Depot de ion y añádelo a tu cuenta.
VITE_MARS_ION_ASSET_ID=3644333
