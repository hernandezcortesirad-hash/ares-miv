# Copia este archivo como .env.local y rellena tus valores (.env.local está en .gitignore).

# Token gratuito de https://ion.cesium.com/tokens
# Sin token, el visor funciona igual pero sin relieve 3D (solo imagen MOLA/Viking sobre el elipsoide).
VITE_CESIUM_ION_TOKEN=

# Asset de Cesium ion con el terreno 3D de Marte ("Cesium Mars", ID 3644333, verificado).
# Cada persona debe añadirlo a SU cuenta: ion.cesium.com → Asset Depot → buscar "Mars"
# (por nombre, no por número) → "Cesium Mars" → Add to my assets.
VITE_MARS_ION_ASSET_ID=3644333

# URL del backend FastAPI. Por defecto se usa el desplegado en Render (no hace falta ponerla).
# Para un backend local: VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=https://ares-miv-geospatial-system.onrender.com/api/v1

# true = el botón "Calcular ruta" usa rutas SIMULADAS (líneas de prueba, etiquetadas en la UI)
# para probar la interfaz sin backend. Déjalo en false para usar el backend real.
VITE_API_MOCK=false

# true = al fijar un punto se comprueba con GET /mars/terrain si es transitable. Déjalo en false
# mientras el backend responda 501 en ese endpoint (solo añadiría errores rojos en la consola).
VITE_TERRAIN_CHECK=false
